# ============================================
# JWT — MUST be at least 32 chars (HS256 requires 256-bit key)
# ============================================
JWT_SECRET=change-me-min-32-chars-long-secret-key-please
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ============================================
# Database passwords (per-service)
# Override these in production!
# ============================================
POSTGRES_USER_PASSWORD=user_pwd
POSTGRES_PRODUCT_PASSWORD=product_pwd
POSTGRES_ORDER_PASSWORD=order_pwd
POSTGRES_NOTIFICATION_PASSWORD=notification_pwd
POSTGRES_ADMIN_PASSWORD=admin_pwd

# ============================================
# Kafka
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ============================================
# MailHog (notification-service SMTP)
# ============================================
MAILHOG_HOST=localhost
MAILHOG_PORT=1025
MAILHOG_SMTP_HOST=localhost
MAILHOG_SMTP_PORT=1025

# ============================================
# Zipkin (distributed tracing)
# ============================================
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# ============================================
# Eureka service registry
# ============================================
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# ============================================
# Inter-service URLs (OpenFeign clients)
# ============================================
USER_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084
ADMIN_SERVICE_URL=http://localhost:8085

# ============================================
# CORS — allowed origins (comma-separated)
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# ============================================
# Spring profile (local / dev / prod)
# ============================================
SPRING_PROFILES_ACTIVE=local

# ============================================
# Tracing sampling probability (1.0 = 100% for dev)
# ============================================
TRACING_SAMPLING_PROBABILITY=1.0
